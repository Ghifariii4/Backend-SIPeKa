{
  "info": {
    "_postman_id": "sipeka-express-v1",
    "name": "SIPeKa Express.js REST API",
    "description": "Koleksi Postman lengkap untuk Backend SIPeKa (Node.js & Express.js)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Pembeli",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"3344556677\",\n  \"name\": \"Budi Siswa\",\n  \"password\": \"password123\",\n  \"role\": \"pembeli\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Penitip",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"1122334455\",\n  \"name\": \"Ibu Siti Penitip\",\n  \"password\": \"password123\",\n  \"role\": \"penitip\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"9999999999\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Approve User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users/:id/approve", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":id", "approve"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Create Internal User (Kasir / Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"1234567890\",\n  \"name\": \"Ahmad Kasir\",\n  \"password\": \"password123\",\n  \"role\": \"kasir\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users/internal", "host": ["{{baseUrl}}"], "path": ["admin", "users", "internal"] }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        }
      ]
    },
    {
      "name": "Shifts",
      "item": [
        {
          "name": "Clock-In (Buka Shift)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"starting_cash\": 50000\n}"
            },
            "url": { "raw": "{{baseUrl}}/shifts/clock-in", "host": ["{{baseUrl}}"], "path": ["shifts", "clock-in"] }
          }
        },
        {
          "name": "Clock-Out (Tutup Shift)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/shifts/clock-out", "host": ["{{baseUrl}}"], "path": ["shifts", "clock-out"] }
          }
        },
        {
          "name": "Get Current Shift",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/shifts/current", "host": ["{{baseUrl}}"], "path": ["shifts", "current"] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Products (Stock > 0)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Roti Bakar Cokelat\",\n  \"price\": 17500,\n  \"school_margin\": 1000,\n  \"stock\": 20\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        }
      ]
    },
    {
      "name": "POS & Orders",
      "item": [
        {
          "name": "Create POS Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"PRODUCT_UUID_HERE\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/pos/transaction", "host": ["{{baseUrl}}"], "path": ["pos", "transaction"] }
          }
        },
        {
          "name": "Scan QR Code Pre-Order",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/pos/scan/:qr_code", "host": ["{{baseUrl}}"], "path": ["pos", "scan", ":qr_code"], "variable": [{ "key": "qr_code", "value": "" }] }
          }
        },
        {
          "name": "Get Orders History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        }
      ]
    }
  ]
}
