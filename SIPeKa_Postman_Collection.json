{
  "info": {
    "_postman_id": "8c459b12-sipeka-smkn8-postman-collection",
    "name": "SIPeKa API - SMK Negeri 8",
    "description": "Koleksi Postman resmi untuk pengujian seluruh endpoint REST API SIPeKa (Aplikasi PKK SMKN 8). Dilengkapi test script otomatis untuk menyimpan token JWT ke variable setelah login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8081/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["health"]
        },
        "description": "Mengecek status ketersediaan server SIPeKa"
      },
      "response": []
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST Register (Pembeli / Penitip)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"5566778899\",\n  \"name\": \"Budi Siswa Pembeli\",\n  \"password\": \"password123\",\n  \"role\": \"pembeli\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Registrasi mandiri untuk akun 'pembeli' (langsung aktif) atau 'penitip' (menunggu persetujuan admin). Role 'kasir' dan 'admin' dilarang registrasi mandiri (403 Forbidden)."
          },
          "response": []
        },
        {
          "name": "POST Login (Dapatkan Token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Otomatis simpan token JWT ke collection variable",
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", json.data.token);",
                  "        console.log(\"JWT Token otomatis disimpan ke collection variable: jwt_token\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"1234567890\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentikasi akun pengguna (kasir / admin / pembeli / penitip). Jika akun penitip belum disetujui (is_active=false), akan menerima HTTP 403. Script otomatis menyimpan token ke variable `jwt_token`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Admin Management (Khusus Admin)",
      "item": [
        {
          "name": "GET Daftar User (Filter Role & Status)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users?is_active=false",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"],
              "query": [
                {
                  "key": "is_active",
                  "value": "false",
                  "description": "Filter status aktif (false untuk melihat penitip yang menunggu approval)"
                },
                {
                  "key": "role",
                  "value": "penitip",
                  "description": "Filter role pengguna",
                  "disabled": true
                }
              ]
            },
            "description": "Melihat daftar seluruh pengguna dalam sistem SIPeKa, berguna untuk melihat user yang menunggu persetujuan Admin."
          },
          "response": []
        },
        {
          "name": "POST Buat User Internal (Kasir / Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"1112223334\",\n  \"name\": \"Kasir Shift Sore\",\n  \"password\": \"password123\",\n  \"role\": \"kasir\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"]
            },
            "description": "Endpoint khusus Admin untuk membuat akun internal (kasir atau admin baru). Akun langsung aktif (is_active = true)."
          },
          "response": []
        },
        {
          "name": "PUT Approve Akun Penitip by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users/MASUKKAN_USER_ID/approve",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "MASUKKAN_USER_ID", "approve"]
            },
            "description": "Endpoint khusus Admin untuk menyetujui akun penitip baru sehingga is_active menjadi true dan pengguna dapat login."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Products (Katalog)",
      "item": [
        {
          "name": "GET Daftar Produk (Ambil Product ID & Stok)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "q",
                  "value": "",
                  "description": "Filter pencarian nama produk (opsional)",
                  "disabled": true
                }
              ]
            },
            "description": "Mengambil seluruh daftar produk konsinyasi PKK yang aktif. Berguna untuk mengambil `product_id` sebelum melakukan transaksi POS."
          },
          "response": []
        },
        {
          "name": "GET Detail Produk by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/MASUKKAN_PRODUCT_ID",
              "host": ["{{base_url}}"],
              "path": ["products", "MASUKKAN_PRODUCT_ID"]
            },
            "description": "Mengambil detail satu produk PKK berdasarkan ID produk."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Shifts (Kasir)",
      "item": [
        {
          "name": "POST Clock-In (Buka Sesi Shift Kasir)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shifts/clock-in",
              "host": ["{{base_url}}"],
              "path": ["shifts", "clock-in"]
            },
            "description": "Membuka sesi kerja shift baru untuk kasir yang sedang login. Harus dijalankan sebelum melakukan transaksi POS."
          },
          "response": []
        },
        {
          "name": "GET Cek Shift Aktif Saat Ini",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shifts/current",
              "host": ["{{base_url}}"],
              "path": ["shifts", "current"]
            },
            "description": "Melihat informasi shift yang sedang aktif untuk kasir yang login beserta akumulasi kas fisik (`expected_cash`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Point of Sale (POS)",
      "item": [
        {
          "name": "POST Transaksi Beli Langsung",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_type\": \"direct\",\n  \"items\": [\n    {\n      \"product_id\": \"PASTE_PRODUCT_ID_DARI_GET_PRODUCTS\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pos/transaction",
              "host": ["{{base_url}}"],
              "path": ["pos", "transaction"]
            },
            "description": "Memproses pesanan langsung di kasir (POS). Mengurangi stok secara realtime dalam transaksi database ACID dan menambah `expected_cash` pada shift kasir."
          },
          "response": []
        },
        {
          "name": "PUT Scan QR Code Pre-Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pos/scan/ORD-PRE-20260923-001",
              "host": ["{{base_url}}"],
              "path": ["pos", "scan", "ORD-PRE-20260923-001"]
            },
            "description": "Memvalidasi pengambilan barang pre-order melalui QR Code. Mengubah status order menjadi 'completed' dan mengaitkan nominal ke shift kasir yang bertugas."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Orders (Riwayat Transaksi)",
      "item": [
        {
          "name": "GET Riwayat Seluruh Transaksi",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "completed",
                  "description": "Filter status: pending, completed, cancelled",
                  "disabled": true
                },
                {
                  "key": "order_type",
                  "value": "direct",
                  "description": "Filter tipe: direct, pre_order",
                  "disabled": true
                }
              ]
            },
            "description": "Melihat riwayat seluruh pesanan dan transaksi POS beserta rincian item produk."
          },
          "response": []
        },
        {
          "name": "GET Detail Transaksi by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/MASUKKAN_ORDER_ID",
              "host": ["{{base_url}}"],
              "path": ["orders", "MASUKKAN_ORDER_ID"]
            },
            "description": "Melihat detail lengkap satu transaksi pesanan beserta data kasir dan pembeli."
          },
          "response": []
        }
      ]
    }
  ]
}
