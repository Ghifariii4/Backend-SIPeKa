{
  "info": {
    "_postman_id": "8c459b12-sipeka-smkn8-postman-collection",
    "name": "SIPeKa API - SMK Negeri 8",
    "description": "Koleksi Postman resmi untuk pengujian seluruh endpoint REST API SIPeKa (Aplikasi PKK SMKN 8). Dilengkapi test script otomatis untuk menyimpan token JWT ke variable setelah login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["health"]
        },
        "description": "Mengecek status ketersediaan server SIPeKa"
      },
      "response": []
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (Dapatkan Token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Otomatis simpan token JWT ke collection variable",
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", json.data.token);",
                  "        console.log(\"JWT Token otomatis disimpan ke collection variable: jwt_token\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn_nip\": \"1234567890\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentikasi akun pengguna (kasir / admin / pembeli / penitip). Script otomatis menyimpan token ke variable `jwt_token`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Shifts",
      "item": [
        {
          "name": "Clock-In Kasir (Membuka Shift)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shifts/clock-in",
              "host": ["{{base_url}}"],
              "path": ["shifts", "clock-in"]
            },
            "description": "Membuka sesi shift aktif baru untuk kasir yang sedang login."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. POS (Point of Sale)",
      "item": [
        {
          "name": "Transaksi Beli Langsung (POS Regular)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"PASTE_PRODUCT_ID_HERE\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pos/transaction",
              "host": ["{{base_url}}"],
              "path": ["pos", "transaction"]
            },
            "description": "Membuat transaksi langsung (direct) di kasir dengan penguncian baris stok (Row-Level Locking) dan pembaruan expected_cash shift."
          },
          "response": []
        },
        {
          "name": "Scan QR Code Pre-Order (POS Pengambilan)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pos/scan/ORD-PRE-20260923-001",
              "host": ["{{base_url}}"],
              "path": ["pos", "scan", "ORD-PRE-20260923-001"]
            },
            "description": "Memvalidasi kode QR unik pesanan pre-order, mengubah status menjadi 'completed', dan mengakumulasikan total pesanan ke expected_cash shift kasir."
          },
          "response": []
        }
      ]
    }
  ]
}
